{
    "name": "sci-relais/laravel",
    "description": "Client Laravel de l'API Sci Relais : relais, prix, envois, suivi et notifications signées.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livraison", "relais", "sci-relais"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {"SciRelais\\Laravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"SciRelais\\Laravel\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["SciRelais\\Laravel\\SciServiceProvider"],
            "aliases": {"Sci": "SciRelais\\Laravel\\Facades\\Sci"}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
